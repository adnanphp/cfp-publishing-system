# ============================================
# CFP Backend - Environment Configuration
# ============================================
# Copy this file to .env and update values for development
# For production, use .env.production with appropriate values

# ============ APPLICATION SETTINGS ============
APP_NAME="CopyForward Publishing"
APP_ENVIRONMENT=development # development, staging, production
APP_VERSION=1.0.0
APP_PORT=8080
APP_HOST=0.0.0.0
APP_DOMAIN=http://localhost:8080
APP_ORIGINS=http://localhost:3000,http://localhost:8080

# ============ DATABASE CONFIGURATION ============
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://cfp_user:password@localhost:5432/cfp_db?sslmode=disable

# SQLite (for development/testing)
# DATABASE_URL=sqlite:./data/cfp.db

# MySQL (alternative)
# DATABASE_URL=mysql://cfp_user:password@localhost:3306/cfp_db

# ============ DATABASE POOL SETTINGS ============
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT=30
DATABASE_IDLE_TIMEOUT=300

# ============ JWT & AUTHENTICATION ============
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=86400 # 24 hours in seconds
JWT_REFRESH_EXPIRATION=604800 # 7 days in seconds

# Password hashing
ARGON2_MEMORY_COST=65536 # 64MB
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ============ EMAIL CONFIGURATION ============
# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="CFP System"
SMTP_FROM_EMAIL=noreply@cfp.example.com
SMTP_USE_TLS=true

# Email verification
EMAIL_VERIFICATION_ENABLED=true
VERIFICATION_EXPIRY_HOURS=24

# ============ FILE UPLOAD CONFIGURATION ============
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800 # 50MB in bytes
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,epub
ENABLE_FILE_SCANNING=true

# ============ RATE LIMITING ============
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60 # seconds
RATE_LIMIT_ENABLED=true

# ============ CORS SETTINGS ============
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ============ CACHE SETTINGS ============
# Redis configuration
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10
CACHE_TTL=300 # 5 minutes in seconds

# ============ LOGGING CONFIGURATION ============
LOG_LEVEL=info # debug, info, warn, error
LOG_FILE=./logs/cfp.log
LOG_FORMAT=json # json, text
LOG_ROTATION_SIZE=10485760 # 10MB
LOG_MAX_FILES=10

# ============ MONITORING & METRICS ============
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_ENDPOINT=/health
PROMETHEUS_ENDPOINT=/metrics

# ============ EXTERNAL SERVICES ============
# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Plagiarism Detection API
PLAGIARISM_API_KEY=your-plagiarism-api-key
PLAGIARISM_API_URL=https://api.plagiarismcheck.org/v1

# ORCID API
ORCID_CLIENT_ID=your-orcid-client-id
ORCID_CLIENT_SECRET=your-orcid-client-secret
ORCID_API_URL=https://orcid.org

# ============ SECURITY SETTINGS ============
# HTTPS/TLS
ENABLE_HTTPS=false
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# Security headers
ENABLE_SECURITY_HEADERS=true
CONTENT_SECURITY_POLICY="default-src 'self'"
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Session security
SESSION_SECRET=your-session-secret-key-change-this
SESSION_TIMEOUT=3600 # 1 hour in seconds

# ============ FEATURE FLAGS ============
FEATURE_TWO_FACTOR_AUTH=true
FEATURE_SOCIAL_LOGIN=false
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_PUSH_NOTIFICATIONS=false
FEATURE_BATCH_PROCESSING=true

# ============ TESTING CONFIGURATION ============
# Only for testing environment
TEST_DATABASE_URL=sqlite::memory:
TEST_JWT_SECRET=test-jwt-secret-key-for-testing-only
TEST_EMAIL_ENABLED=false
