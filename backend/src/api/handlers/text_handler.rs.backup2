pub async fn get_texts(
    query: web::Query<PaginationQuery>,
) -> impl Responder {
    let pagination = query.into_inner();
    let page = pagination.get_page();
    let limit = pagination.get_limit();

    // Fetch texts from database
    let texts = vec![
        TextResponse {
            text_id: 1,
            title: "Sample Text".to_string(),
            abstract_text: Some("This is a sample text abstract.".to_string()),
            content_preview: "This is a preview of the text content...".to_string(),
            topic: Some("Technology".to_string()),
            keywords: vec!["sample".to_string(), "technology".to_string()],
            author_orcid: Some("0000-0000-0000-0000".to_string()),
            author_name: Some("John Doe".to_string()),
            author_bio: Some("Expert in technology".to_string()),
            upload_date: chrono::NaiveDate::from_ymd_opt(2023, 1, 1).unwrap(),
            last_updated: chrono::NaiveDate::from_ymd_opt(2023, 1, 15).unwrap(),
            status: "published".to_string(),
            version: 1,
            download_count: 100,
            total_donations: 500.0,
            avg_rating: Some(4.5),
            rating_count: 20,
            comment_count: 15,
            license_type: "CC BY 4.0".to_string(),
            language: "en".to_string(),
            file_size: 1024 * 1024, // 1MB
            file_format: "PDF".to_string(),
            word_count: 5000,
            reading_time_minutes: 25,
            is_featured: true,
            categories: vec!["Technology".to_string(), "Science".to_string()],
            references: vec!["Reference 1".to_string(), "Reference 2".to_string()],
        },
    ];

    let response = crate::api::handlers::PaginatedResponse::new(texts, 1, page, limit);
    ApiResponse::success(response).to_http_response(actix_web::http::StatusCode::OK)
}

