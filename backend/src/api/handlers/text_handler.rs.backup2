pub async fn create_text(
    req: actix_web::HttpRequest,
    request: web::Json<CreateTextRequest>,
) -> impl Responder {
    let user_id = match HandlerUtils::extract_user_id(&req) {
        Ok(id) => id,
        Err(resp) => return resp,
    };

    if let Err(validation_errors) = request.validate() {
        return HandlerUtils::validate_request(&request.into_inner()).unwrap_err();
    }

    let text_request = request.into_inner();

    // Create text in database
    // This would typically involve:
    // 1. Validate author ORCID (if provided)
    // 2. Process content (strip formatting, calculate stats)
    // 3. Create initial version
    // 4. If not draft, send for moderation

    let text_id = 123; // Generated ID

    HandlerUtils::log_operation(
        user_id,
        "create_text",
        "text",
        Some(text_id),
        &format!("Title: {}", text_request.title),
    );

    ApiResponse::success_with_message(
        TextCreatedResponse {
            text_id,
            title: text_request.title,
            status: if text_request.is_draft.unwrap_or(false) {
                "draft".to_string()
            } else {
                "under_review".to_string()
            },
            version: 1,
            upload_date: chrono::Utc::now().date_naive(),
        },
        if text_request.is_draft.unwrap_or(false) {
            "Text saved as draft"
        } else {
            "Text submitted for review"
        },
    )
    .to_http_response(actix_web::http::StatusCode::CREATED)
}

