pub async fn export_text(
    path: web::Path<i32>,
    query: web::Query<ExportFormatQuery>,
) -> impl Responder {
    let text_id = path.into_inner();
    let format = query.into_inner().format;

    // Generate export in requested format
    let content = match format.as_str() {
        "pdf" => b"PDF content".to_vec(),
        "epub" => b"EPUB content".to_vec(),
        "txt" => b"Plain text content".to_vec(),
        _ => b"Unsupported format".to_vec(),
    };

    let filename = format!("text_{}.{}", text_id, format);
    let content_type = match format.as_str() {
        "pdf" => "application/pdf",
        "epub" => "application/epub+zip",
        "txt" => "text/plain",
        _ => "application/octet-stream",
    };

    HttpResponse::Ok()
        .content_type(content_type)
        .append_header(("Content-Disposition", format!("attachment; filename=\"{}\"", filename)))
        .body(content)
}

#[derive(Debug, Deserialize)]
pub struct ExportFormatQuery {
    pub format: String,
}

pub async fn batch_upload_texts(
    req: actix_web::HttpRequest,
    request: web::Json<BatchUploadRequest>,
) -> impl Responder {
    let user_id = match HandlerUtils::extract_user_id(&req) {
        Ok(id) => id,
        Err(resp) => return resp,
    };

    if let Err(validation_errors) = request.validate() {
        return HandlerUtils::validate_request(&request.into_inner()).unwrap_err();
    }

    let batch_request = request.into_inner();

    // Process batch upload
    let results: Vec<BatchUploadResult> = batch_request.texts
        .into_iter()
        .enumerate()
        .map(|(i, text)| {
            BatchUploadResult {
                index: i as i32,
                title: text.title,
                status: "success".to_string(),
                text_id: Some(1000 + i as i32),
                message: Some("Uploaded successfully".to_string()),
            }
        })
        .collect();

    HandlerUtils::log_operation(
        user_id,
        "batch_upload",
        "text",
        None,
        &format!("Uploaded {} texts", results.len()),
    );

    ApiResponse::success(BatchUploadResponse {
        batch_id: "batch_123".to_string(),
        total: results.len() as i32,
        successful: results.len() as i32,
        failed: 0,
        results,
    })
    .to_http_response(actix_web::http::StatusCode::CREATED)
}

#[derive(Debug, Deserialize, Validate)]
pub struct BatchUploadRequest {
    pub texts: Vec<CreateTextRequest>,
    pub metadata: Option<serde_json::Value>,
}

#[derive(Debug, Serialize)]
pub struct BatchUploadResponse {
    pub batch_id: String,
    pub total: i32,
    pub successful: i32,
    pub failed: i32,
    pub results: Vec<BatchUploadResult>,
}

#[derive(Debug, Serialize)]
pub struct BatchUploadResult {
    pub index: i32,
    pub title: String,
    pub status: String,
    pub text_id: Option<i32>,
    pub message: Option<String>,
}

