    if let Err(validation_errors) = request.validate() {
        return HandlerUtils::validate_request(&request.into_inner()).unwrap_err();
    }

    let update_request = request.into_inner();

    // Update text in database
    // This would create a new version if content changed

    HandlerUtils::log_operation(
        user_id,
        "update_text",
        "text",
        Some(text_id),
        &format!("Version notes: {:?}", update_request.version_notes),
    );

    ApiResponse::success_with_message(
        TextUpdatedResponse {
            text_id,
