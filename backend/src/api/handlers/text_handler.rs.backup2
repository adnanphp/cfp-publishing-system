pub async fn get_author_texts(
    path: web::Path<String>,
    query: web::Query<PaginationQuery>,
) -> impl Responder {
    let orcid = path.into_inner();
    let pagination = query.into_inner();
    let page = pagination.get_page();
    let limit = pagination.get_limit();

    // Fetch texts by author ORCID
    let texts = vec![
        AuthorTextResponse {
            text_id: 1,
            title: "Author's First Paper".to_string(),
            upload_date: chrono::NaiveDate::from_ymd_opt(2023, 1, 1).unwrap(),
            status: "published".to_string(),
            download_count: 100,
            total_donations: 500.0,
            avg_rating: Some(4.5),
        },
    ];

    let response = crate::api::handlers::PaginatedResponse::new(texts, 1, page, limit);
    ApiResponse::success(response).to_http_response(actix_web::http::StatusCode::OK)
}

#[derive(Debug, Serialize)]
pub struct AuthorTextResponse {
    pub text_id: i32,
    pub title: String,
    pub upload_date: chrono::NaiveDate,
    pub status: String,
    pub download_count: i32,
    pub total_donations: f64,
    pub avg_rating: Option<f64>,
}
