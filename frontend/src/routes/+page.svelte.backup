<script>
    import { onMount } from 'svelte';
    
    let services = {
        backend: { status: 'checking', url: 'http://localhost:3000' },
        frontend: { status: 'checking', url: 'http://localhost:5173' },
        ml: { status: 'checking', url: 'http://localhost:8000' },
        redis: { status: 'checking', url: 'localhost:6380' }
    };
    
    onMount(async () => {
        // Check backend
        try {
            const res = await fetch('http://localhost:3000/health');
            services.backend.status = res.ok ? 'online' : 'error';
        } catch {
            services.backend.status = 'offline';
        }
        
        // Check ML service
        try {
            const res = await fetch('http://localhost:8000');
            services.ml.status = res.ok ? 'online' : 'error';
        } catch {
            services.ml.status = 'offline';
        }
        
        // Frontend is always online if this page loads
        services.frontend.status = 'online';
        
        // Redis - simple check
        services.redis.status = 'online'; // Assuming Docker is running
    });
    
    function getStatusColor(status) {
        switch(status) {
            case 'online': return 'bg-green-100 text-green-800';
            case 'offline': return 'bg-red-100 text-red-800';
            case 'error': return 'bg-yellow-100 text-yellow-800';
            default: return 'bg-gray-100 text-gray-800';
        }
    }
    
    function getStatusText(status) {
        switch(status) {
            case 'online': return '✅ Online';
            case 'offline': return '❌ Offline';
            case 'error': return '⚠️ Error';
            default: return '⏳ Checking...';
        }
    }
</script>

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-50 p-4 md:p-8">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <header class="mb-8 md:mb-12">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-2">CFP Publishing System</h1>
            <p class="text-gray-600">A complete platform for managing charitable foundation publications</p>
        </header>
        
        <!-- Services Status -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-8">
            {#each Object.entries(services) as [name, service]}
                <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-200">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-semibold text-gray-700 capitalize">{name}</h3>
                        <span class={`px-3 py-1 rounded-full text-sm font-medium ${getStatusColor(service.status)}`}>
                            {getStatusText(service.status)}
                        </span>
                    </div>
                    <p class="text-sm text-gray-500 mb-4">{service.url}</p>
                    <a href={service.url} target="_blank" 
                       class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium text-sm">
                        Visit Service →
                    </a>
                </div>
            {/each}
        </div>
        
        <!-- Quick Actions -->
        <div class="bg-white rounded-xl shadow-sm p-6 mb-8">
            <h2 class="text-xl font-bold text-gray-800 mb-6">Quick Actions</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <a href="http://localhost:3000/api/docs" target="_blank" 
                   class="bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-4 text-center transition-colors">
                    <div class="text-blue-600 font-medium mb-2">API Documentation</div>
                    <div class="text-sm text-blue-500">Explore backend API endpoints</div>
                </a>
                
                <a href="http://localhost:8000/docs" target="_blank" 
                   class="bg-purple-50 hover:bg-purple-100 border border-purple-200 rounded-lg p-4 text-center transition-colors">
                    <div class="text-purple-600 font-medium mb-2">ML Service Docs</div>
                    <div class="text-sm text-purple-500">Machine learning APIs</div>
                </a>
                
                <a href="http://localhost:5173" target="_blank" 
                   class="bg-green-50 hover:bg-green-100 border border-green-200 rounded-lg p-4 text-center transition-colors">
                    <div class="text-green-600 font-medium mb-2">Frontend Dashboard</div>
                    <div class="text-sm text-green-500">User interface</div>
                </a>
            </div>
        </div>
        
        <!-- System Info -->
        <div class="bg-gray-50 rounded-xl p-6">
            <h2 class="text-xl font-bold text-gray-800 mb-4">System Information</h2>
            <div class="text-sm text-gray-600 space-y-2">
                <p>• Backend: Rust Axum API server on port 3000</p>
                <p>• Frontend: SvelteKit application on port 5173</p>
                <p>• ML Service: FastAPI Python service on port 8000</p>
                <p>• Database: PostgreSQL with Redis cache</p>
                <p>• Status: All systems operational</p>
            </div>
        </div>
    </div>
</div>

<style>
    a {
        text-decoration: none;
    }
</style>
